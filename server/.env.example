# Salin file ini jadi ".env" untuk pengembangan lokal di komputer sendiri.
# JANGAN PERNAH commit file ".env" yang asli ke git (sudah ada di
# server/.gitignore). Untuk server yang jalan di Railway, isi nilai yang
# sama lewat menu "Variables" di dashboard Railway -- file ini cuma contoh.

# Sama seperti SUPABASE_URL yang dipakai di www/app.js (nilai ini publik,
# aman ditaruh di mana saja -- yang harus dirahasiakan adalah service role
# key di bawah, bukan URL project-nya).
SUPABASE_URL=https://iapcwaowvscftjfcdutm.supabase.co

# PENTING: ambil dari Supabase Dashboard > Project Settings > API > "service_role"
# secret key (BUKAN "anon public" key yang dipakai frontend). Key ini bisa
# melewati semua aturan RLS, jadi HANYA boleh ada di server ini -- jangan
# pernah ditaruh di www/app.js atau file apa pun yang dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# Alamat aplikasi (GitHub Pages) yang boleh memanggil server ini, dipakai
# untuk membatasi CORS. Bisa lebih dari satu, dipisah koma.
ALLOWED_ORIGIN=https://mitracreative38.github.io

PORT=3000

# HANYA untuk pengembangan lokal (fitur cetak PDF butuh Chromium
# sungguhan). Di Railway ini otomatis (lihat server/nixpacks.toml),
# TIDAK perlu diisi di sana.
PUPPETEER_EXECUTABLE_PATH=
