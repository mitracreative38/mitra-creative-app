# Salin file ini jadi ".env" untuk pengembangan lokal di komputer sendiri.
# JANGAN PERNAH commit file ".env" yang asli ke git (sudah ada di
# server/.gitignore). Untuk server yang jalan di Railway, isi nilai yang
# sama lewat menu "Variables" di dashboard Railway -- file ini cuma contoh.

# Sama seperti SUPABASE_URL yang dipakai di www/app.js (nilai ini publik,
# aman ditaruh di mana saja -- yang harus dirahasiakan adalah service role
# key di bawah, bukan URL project-nya).
SUPABASE_URL=https://iapcwaowvscftjfcdutm.supabase.co

# PENTING: ambil dari Supabase Dashboard > Project Settings > API > "service_role"
# secret key (BUKAN "anon public" key yang dipakai frontend). Key ini bisa
# melewati semua aturan RLS, jadi HANYA boleh ada di server ini -- jangan
# pernah ditaruh di www/app.js atau file apa pun yang dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# Alamat aplikasi (GitHub Pages) yang boleh memanggil server ini, dipakai
# untuk membatasi CORS. Bisa lebih dari satu, dipisah koma.
ALLOWED_ORIGIN=https://mitracreative38.github.io

PORT=3000

# Opsional -- Chromium untuk cetak PDF otomatis terdownload lewat "npm
# install" (paket "puppeteer"), jadi ini biasanya TIDAK perlu diisi, baik
# lokal maupun di Railway. Isi cuma kalau mau pakai Chrome/Chromium lain
# yang sudah ter-install sendiri (override).
PUPPETEER_EXECUTABLE_PATH=

# Pengingat WhatsApp/Email otomatis (Fase 1.0) -- follow-up Klien jatuh
# tempo & Kas Perusahaan menunggu persetujuan. Kalau salah satu/keduanya
# dikosongkan, pengecekan tetap jalan tapi pengirimannya gagal-lembut
# (cuma dicatat ke log server, tidak mengganggu fitur lain).

# Daftar/login di https://fonnte.com > Tambah Device (scan QR pakai WA
# yang mau dipakai kirim pengingat) > salin "Token" perangkat itu ke sini.
FONNTE_TOKEN=

# Daftar di https://resend.com > API Keys > Create API Key > salin ke sini.
RESEND_API_KEY=
# Alamat pengirim email. Kalau belum verifikasi domain sendiri di Resend,
# boleh dibiarkan kosong (pakai alamat sandbox "onboarding@resend.dev" --
# cukup untuk kirim ke email yang sama dengan akun Resend Anda; untuk
# kirim ke email siapa pun perlu verifikasi domain dulu di dashboard
# Resend, baru isi alamat pengirim dari domain itu di sini).
RESEND_FROM_EMAIL=

# Payment Gateway (Fase 1.1) -- link pembayaran online untuk Termin Proyek
# & DP Penawaran, lewat Xendit. Kalau XENDIT_SECRET_KEY dikosongkan,
# tombol "Buat Link Pembayaran" di aplikasi akan gagal-lembut dengan
# pesan error yang jelas (bukan error tak terduga).

# 1. Daftar di https://dashboard.xendit.co (mode Live perlu verifikasi
#    bisnis dulu -- selama menunggu, mode Test/sandbox sudah bisa dipakai
#    untuk mencoba alur pembayarannya).
# 2. Settings > API Keys > salin "Secret Key" ke sini.
XENDIT_SECRET_KEY=

# 3. Settings > Webhooks > isi URL webhook dengan:
#    <alamat-server-Railway-Anda>/api/payment/webhook
#    lalu salin "Verification Token" yang ditampilkan Xendit ke sini --
#    dipakai server untuk memastikan notifikasi "sudah dibayar" itu
#    memang benar dari Xendit, bukan pemalsuan.
XENDIT_CALLBACK_TOKEN=

# Opsional -- halaman yang dilihat klien setelah selesai bayar (murni
# kosmetik). Kalau dikosongkan, otomatis memakai alamat GitHub Pages
# aplikasi ini.
APP_PUBLIC_URL=
